<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.easyjob.mapper.ArticleSearchMapper">
    <select id="findCurrentArticles" resultType="map">
        SELECT article_id,required_level,summary FROM article_info WHERE status=1 AND deleted=0 AND <choose><when test="ids != null and !ids.isEmpty()">article_id IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach></when><otherwise>1=0</otherwise></choose>
    </select>
</mapper>

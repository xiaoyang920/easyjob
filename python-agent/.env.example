# DeepSeek API
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash

# Java 后端余额预警；scripts/prepare-local.py 写入本地 Java 配置。
# 启用前执行 028_provider_balance_monitor.sql 迁移，复用 spring.mail 的 SMTP 账号。
DEEPSEEK_BALANCE_ALERT_ENABLED=false
DEEPSEEK_BALANCE_ALERT_THRESHOLD=2.00
DEEPSEEK_BALANCE_ALERT_CURRENCY=CNY
DEEPSEEK_BALANCE_ALERT_RECIPIENT=
DEEPSEEK_BALANCE_ALERT_INTERVAL_SECONDS=600

# Summary input budget; the shared context guard still reserves output and safety space.
AGENT_SUMMARY_INPUT_MAX_TOKENS=262144

# DashScope (阿里云)
DASHSCOPE_API_KEY=your-dashscope-api-key

# Query embedding cache: process-local, bounded; 0 disables caching.
AGENT_QUERY_VECTOR_CACHE_CAPACITY=512
AGENT_QUERY_VECTOR_CACHE_TTL_SECONDS=600
# Provisional text only; first text and progress/control events flush immediately.
AGENT_STREAM_COALESCE_MS=120

# Elasticsearch
ES_HOST=localhost
ES_PORT=9200

# Internal RPC: Java Dubbo Triple <-> Python gRPC, on a private/loopback network.
AGENT_INTERNAL_TRANSPORT=triple
AGENT_RPC_ENABLED=true
AGENT_RPC_BIND=127.0.0.1:50051
BLOG_RPC_TARGET=127.0.0.1:20881

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# 成功运行保留1天；失败/取消/过期保留7天。运行中、待审批不使用统一短 TTL。
AGENT_CHECKPOINT_SUCCESS_RETENTION_DAYS=1
AGENT_CHECKPOINT_FAILURE_RETENTION_DAYS=7

# DeepSeek Search / Fetch（共用上面的 DEEPSEEK_API_KEY）
DEEPSEEK_TOOLS_BASE_URL=https://api.deepseek.com/v1

ZHIPUAI_API_KEY=your-zhipu-api-key
ZHIPU_EMBEDDING_MODEL=embedding-3
ZHIPU_EMBEDDING_DIMENSIONS=2048
# Final sourced delivery only: one audit, at most one repair and one re-audit.
AGENT_GROUNDING_TIMEOUT_SECONDS=25
AGENT_GROUNDING_OUTPUT_MAX_TOKENS=4096
## Service discovery (local launcher enables this; direct RPC remains available)
SERVICE_DISCOVERY_ENABLED=false
CONSUL_URL=http://127.0.0.1:8500
CONSUL_TOKEN=
SERVICE_ADVERTISE_HOST=127.0.0.1
AGENT_HTTP_PORT=8000
AGENT_INSTANCE_ID=
# Public Agent HTTP: gateway assertion verification and online SSE session checks.
# prepare-local.py supplies these locally; Compose mounts only the gateway public key.
GATEWAY_IDENTITY_PUBLIC_KEY_FILE=
AUTH_SERVICE_BASE_URL=http://127.0.0.1:8081
AUTH_SERVICE_CHECK_KEY=
# Allow full tool results when the complete Main request fits below compaction.
# Set false to reproduce the fixed 32K projection for comparison.
AGENT_CONTEXT_TOOL_ADAPTIVE_INLINE=true
# Select current results and state-local read spans instead of all older bodies.
# false rolls back to the previous adaptive-inline strategy.
AGENT_CONTEXT_RESULT_ACCESS_ENABLED=true
AGENT_CONTEXT_BUILD_CACHE_ENABLED=true
# Opt-in until paired live evaluation passes; numeric budget calibration is observational.
AGENT_CONTEXT_RESULT_PREFETCH_ENABLED=false
AGENT_CONTEXT_RESULT_SMALL_TOKENS=8192
# System tracing (IDE/manual startup). PowerShell learning launchers provide these
# defaults when not explicitly set. Set LAB_ONLY=false to retain Langfuse callbacks.
EASYJOB_TRACING_ENABLED=true
EASYJOB_TRACING_LAB_ONLY=true
OTEL_SERVICE_NAME=easyjob-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:14318
OTEL_TRACES_SAMPLER_ARG=1.0

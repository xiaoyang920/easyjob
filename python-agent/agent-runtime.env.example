# Use the same random secret (at least 32 bytes) in Java and Python.
# Do not expose service endpoints directly to the public internet.
AGENT_SERVICE_KEY=
JAVA_AGENT_URL=http://localhost:8080
AGENT_INTERNAL_TRANSPORT=triple
AGENT_RPC_ENABLED=true
AGENT_RPC_BIND=127.0.0.1:50051
BLOG_RPC_TARGET=127.0.0.1:20881
AGENT_RUN_TIMEOUT_SECONDS=300
AGENT_MAIN_MAX_ROUNDS=8
AGENT_MAIN_MAX_TASKS=8
AGENT_MAIN_CONTEXT_MAX_CHARS=1048576
AGENT_MAIN_OUTPUT_MAX_CHARS=65536
AGENT_TASK_RESULT_MAX_CHARS=131072
AGENT_DEPENDENCY_MAX_CHARS=524288
# Application Token budgets; local BPE estimates include schemas and message overhead.
AGENT_MAIN_CONTEXT_MAX_TOKENS=131072
AGENT_MAIN_OUTPUT_MAX_TOKENS=8192
AGENT_WORKER_OUTPUT_MAX_TOKENS=16384
AGENT_CONTEXT_SAFETY_TOKENS=8192
AGENT_CONTEXT_COMPACT_TRIGGER_TOKENS=98304
AGENT_CONTEXT_COMPACT_TARGET_TOKENS=65536
AGENT_CONTEXT_COMPACT_MIN_SAVING_TOKENS=4096
# Applies only to auxiliary rewrite/chat helpers, not Main or conversation loading.
AGENT_AUXILIARY_HISTORY_MAX_TOKENS=32768
AGENT_HISTORY_RECENT_TOKENS=24576
AGENT_ARTICLE_CONTEXT_MAX_TOKENS=8192
AGENT_SUMMARY_MAX_TOKENS=4096
AGENT_SUMMARY_INPUT_MAX_TOKENS=32768
AGENT_SUMMARY_MAX_CALLS=8
AGENT_SUMMARY_TIMEOUT_SECONDS=45
AGENT_SUBAGENT_CONCURRENCY=3
# Server upper bound. Main/Delegate allow_web requests cannot override false.
AGENT_WEB_SEARCH_ENABLED=true
AGENT_APPROVAL_TIMEOUT_SECONDS=86400
COARSE_TOP_K=20
RERANK_TOP_K=5
# Java opt-in only: RAG_REINDEX_ENABLED=true rebuilds published HTML chunks.
# Remove/disable this flag after the one-time rebuild.
# Java: agent.python-url=http://localhost:8000 (Spring property)
AGENT_RETRIEVAL_CONCURRENCY=4
AGENT_RETRIEVAL_TIMEOUT_SECONDS=30
AGENT_MEMORY_INPUT_MAX_TOKENS=16384
AGENT_MEMORY_OUTPUT_MAX_TOKENS=2048
AGENT_BACKGROUND_JOB_MAX_ATTEMPTS=8
